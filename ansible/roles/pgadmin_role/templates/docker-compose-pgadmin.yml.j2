version: '3.8'

services:
  {{ pgadmin_service_name }}:
    image: dpage/pgadmin4
    container_name: {{ pgadmin_container_name }}
    environment:
      - PGADMIN_DEFAULT_EMAIL=admin@icgroup.com
      - PGADMIN_DEFAULT_PASSWORD=adminpassword
    ports:
      - "5050:80"
    volumes:
      - "{{ pgadmin_local_volume_path }}:/var/lib/pgadmin"
    networks:
      - {{ docker_network_name }}
    restart: always

  webapp_service:
    image: "{{ docker_user }}/ic-webapp:{{ app_version }}"
    container_name: ic_webapp
    ports:
      - "8080:8080"
    networks:
      - {{ docker_network_name }}
    restart: always

networks:
  {{ docker_network_name }}:
    driver: bridge